{
  "name": "guildhordewowclassic",
  "version": "1.0.0",
  "description": "API REST para gestao de guildas da Horda em World of Warcraft Classic.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/init-db.js",
    "db:init:test": "node src/scripts/init-db.js --env=test",
    "test:unit": "mocha \"test/unit/**/*.spec.js\"",
    "test": "mocha --require test/setup.js \"test/api/**/*.spec.js\"",
    "test:html": "mocha --require test/setup.js \"test/api/**/*.spec.js\" --reporter mochawesome --reporter-options reportDir=test-reports/mochawesome,reportFilename=api-tests,html=true,json=true",
    "test:performance": "node test/performance/run-all.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "mochawesome": "^7.1.4",
    "supertest": "^7.2.2"
  }
}
